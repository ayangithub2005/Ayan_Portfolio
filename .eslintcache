vbar from 'react-bootstrap/Navbar'\nimport Nav from 'react-bootstrap/Nav'\nimport Container from 'react-bootstrap/Container'\nimport { Link } from 'react-router-dom'\nimport { CgFileDocument } from 'react-icons/cg'\n\nimport {\n  AiFillStar,\n  AiOutlineHome,\n  AiOutlineFundProjectionScreen,\n  AiOutlineUser,\n  AiOutlineContacts\n} from 'react-icons/ai'\n\nfunction NavBar() {\n  const [expand, updateExpanded] = useState(false)\n  const [navColour, updateNavbar] = useState(false)\n\n  function scrollHandler() {\n    if (window.scrollY >= 20) {\n      updateNavbar(true)\n    } else {\n      updateNavbar(false)\n    }\n  }\n\n  window.addEventListener('scroll', scrollHandler)\n\n  return (\n    <Navbar\n      expanded={expand}\n      fixed=\"top\"\n      expand=\"lg\"\n      className={navColour ? 'sticky' : 'navbar'}\n    >\n      <Container>\n\n        <Navbar.Brand as={Link} to=\"/\">\n          <p\n            style={{\n              color: '#be50f4',\n              margin: 'auto',\n              fontWeight: '700',\n              letterSpacing: '1px',\n              fontSize: '28px',\n            }}\n          >\n            AYAN KUILA\n          </p>\n        </Navbar.Brand>\n\n        <Navbar.Toggle\n          aria-controls=\"responsive-navbar-nav\"\n          onClick={() => {\n            updateExpanded(expand ? false : 'expanded')\n          }}\n        >\n          <span></span>\n          <span></span>\n          <span></span>\n        </Navbar.Toggle>\n\n        <Navbar.Collapse id=\"responsive-navbar-nav\">\n          <Nav className=\"ml-auto\" defaultActiveKey=\"#home\">\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineHome style={{ marginBottom: '2px' }} /> Home\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/about\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineUser style={{ marginBottom: '2px' }} /> About\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/project\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineFundProjectionScreen style={{ marginBottom: '2px' }} /> Projects\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/resume\"\n                onClick={() => updateExpanded(false)}\n              >\n                <CgFileDocument style={{ marginBottom: '2px' }} /> Resume\n              </Nav.Link>\n            </Nav.Item>\n\n            <Nav.Item>\n              <Nav.Link\n                as={Link}\n                to=\"/contact\"\n                onClick={() => updateExpanded(false)}\n              >\n                <AiOutlineContacts style={{ marginBottom: '2px' }} /> Contact\n              </Nav.Link>\n            </Nav.Item>\n\n            \n\n          </Nav>\n        </Navbar.Collapse>\n\n      </Container>\n    </Navbar>\n  )\n}\n\nexport default NavBar","C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Home\\Home.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Footer.js",["99","100"],"import React from 'react'\nimport {Container, Row, Col} from 'react-bootstrap'\nimport {AiFillGithub, AiOutlineTwitter, AiFillInstagram} from 'react-icons/ai'\nimport {FaLinkedinIn} from 'react-icons/fa'\n\nfunction Footer() {\n  let date = new Date()\n  let year = date.getFullYear()\n  return (\n    <Container fluid className=\"footer\">\n      <Row>\n        <Col md=\"4\" className=\"footer-copywright\">\n          <h3>Designed and Developed by Ayan Kuila</h3>\n        </Col>\n        <Col md=\"4\" className=\"footer-copywright\">\n          <h3>Copyright © {year} MS</h3>\n        </Col>\n        <Col md=\"4\" className=\"footer-body\">\n          <ul className=\"footer-icons\">\n            <li className=\"social-icons\">\n              <a\n                href=\"https://github.com/ayangithub2005\"\n                style={{color: 'white'}}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >\n                <AiFillGithub />\n              </a>\n            </li>\n\n            <li className=\"social-icons\">\n              <a\n                href=\"https://www.linkedin.com/in/ayankuila/\"\n                style={{color: 'white'}}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n              >\n                <FaLinkedinIn />\n              </a>\n            </li>\n          </ul>\n        </Col>\n      </Row>\n    </Container>\n  )\n}\n\nexport default Footer\n",["101","102"],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Projects\\Projects.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Resume\\Resume.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\About\\Github.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Particle.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\About\\Techstack.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\About\\AboutCard.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\About\\Toolstack.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Home\\Type.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Home\\Home2.js",["103","104"],"import React from 'react'\nimport {Container, Row, Col} from 'react-bootstrap'\nimport myImg from '../../Assets/avatar.jpg'\nimport Tilt from 'react-parallax-tilt'\nimport {AiFillGithub, AiOutlineTwitter, AiFillInstagram} from 'react-icons/ai'\nimport {FaLinkedinIn} from 'react-icons/fa'\n\nfunction Home2() {\n  return (\n    <Container fluid className=\"home-about-section\" id=\"about\">\n      <Container>\n        <Row>\n          <Col md={8} className=\"home-about-description\">\n            <h1 style={{fontSize: '2.6em'}}>\n              LET ME <span className=\"purple\"> INTRODUCE </span> MYSELF\n            </h1>\n            <p className=\"home-about-body\">\n              Hi Everyone, I am Ayan Kuila from India.\n\n              I am a Computer Science Engineering student.\n\n              I enjoy programming and continuously learning new technologies.\n\n              I work with C++, Java, HTML, CSS and JavaScript.\n\n              My areas of interest include\n              Web Development, Artificial Intelligence, DSA and Software Projects.\n\n              I also enjoy building projects and exploring modern technologies.\n              <br />\n              <br />I am fluent in classics like \n              <i>\n              <b className=\"purple\">\n              C++, Java, HTML, CSS and JavaScript\n              </b>\n              </i>\n              <br />\n              <br />\n              My field of Interest's are building new &nbsp;\n              <i>\n                <b className=\"purple\">\n                  Web Technologies, Application developement and Products{' '}\n                </b>{' '}\n                and also in areas related to <b className=\"purple\">Clouds.</b>\n              </i>\n              <br />\n              <br />\n              Whenever possible, I also apply my passion for developing products\n              with <b className=\"purple\">Node.js</b> and\n              <i>\n                <b className=\"purple\">\n                  {' '}\n                  Modern Javascript Library and Frameworks\n                </b>\n              </i>\n              &nbsp; like\n              <i>\n                <b className=\"purple\"> React.js and Next.js</b>\n              </i>\n            </p>\n          </Col>\n          <Col md={4} className=\"myAvtar\">\n            <Tilt>\n              <img src={myImg} className=\"img-fluid\" alt=\"avatar\" />\n            </Tilt>\n          </Col>\n        </Row>\n        <Row>\n          <Col md={12} className=\"home-about-social\">\n            <h1>FIND ME ON</h1>\n            <p>\n              Feel free to <span className=\"purple\">connect </span>with me\n            </p>\n            <ul className=\"home-about-social-links\">\n              <li className=\"social-icons\">\n                <a\n                  href=\"https://github.com/ayangithub2005\"\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"icon-colour  home-social-icons\"\n                >\n                  <AiFillGithub />\n                </a>\n              </li>\n\n              <li className=\"social-icons\">\n                <a\n                  href=\"https://www.linkedin.com/in/ayankuila/\"\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"icon-colour  home-social-icons\"\n                >\n                  <FaLinkedinIn />\n                </a>\n              </li>\n            </ul>\n          </Col>\n        </Row>\n      </Container>\n    </Container>\n  )\n}\nexport default Home2\n","C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Projects\\ProjectCards.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\Resume\\ResumeContent.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-master\\src\\components\\About\\Skillprogress.js",[],"C:\\Users\\workw\\OneDrive\\Desktop\\portofolio\\portfolio-maste